{
  "name": "seenary",
  "version": "0.2.1-beta",
  "description": "Anime and media tracking desktop app.",
  "desktopName": "seenary",
  "main": "main.js",
  "scripts": {
    "test:atlas-metadata": "node scripts/atlas-metadata-smoke.js",
    "test:atlas-metadata-integration": "node scripts/atlas-metadata-integration.js",
    "atlas:metadata-capacity": "node scripts/atlas-metadata-capacity.js",
    "test:atlas-mal-metadata": "node scripts/atlas-mal-metadata-smoke.js",
    "test:atlas-mal-fallback": "node scripts/atlas-mal-fallback-smoke.js",
    "test:atlas-mal-mapping": "node scripts/atlas-mal-mapping-smoke.js",
    "test:atlas-mal-live": "node scripts/atlas-mal-live-integration.js",
    "test:atlas-workers": "node scripts/atlas-worker-smoke.js",
    "test:atlas-provider-delivery": "node scripts/atlas-provider-delivery-smoke.js",
    "test:atlas-inbound": "node scripts/atlas-inbound-smoke.js",
    "test:atlas-cache-maintenance": "node scripts/atlas-cache-maintenance-smoke.js",
    "atlas:cache-maintenance": "node scripts/atlas-cache-maintenance.js",
    "test:atlas-storage-ownership": "node scripts/atlas-storage-ownership-smoke.js",
    "test:atlas-account-data": "node scripts/atlas-account-data-smoke.js",
    "test:atlas-analytics": "node scripts/atlas-analytics-smoke.js",
    "atlas:analytics": "node scripts/atlas-analytics.js",
    "atlas:operations": "node scripts/atlas-operations.js",
    "test:atlas-operations": "node scripts/atlas-operations-smoke.js",
    "atlas:cutover": "node scripts/atlas-cutover.js",
    "cutover:sqlite-snapshot": "node scripts/sqlite-cutover-snapshot.js",
    "atlas:cutover-diff": "node scripts/atlas-cutover-diff.js",
    "test:atlas-cutover": "node scripts/atlas-cutover-smoke.js",
    "test:atlas-production-http": "node scripts/atlas-production-http-smoke.js",
    "atlas:worker": "node scripts/atlas-worker.js",
    "start": "node server.js",
    "atlas": "node scripts/start-atlas-local.js",
    "start:atlas": "node atlas-server.js",
    "atlas:accounts": "node scripts/atlas-accounts.js",
    "atlas:providers": "node scripts/atlas-providers.js",
    "atlas:media": "node scripts/atlas-media.js",
    "atlas:library": "node scripts/atlas-library.js",
    "atlas:normalize-scores": "node scripts/atlas-normalize-scores.js",
    "test:atlas-library": "node scripts/atlas-library-smoke.js",
    "test:atlas-media": "node scripts/atlas-media-smoke.js",
    "test:atlas-providers": "node scripts/atlas-providers-smoke.js",
    "test:atlas-accounts": "node scripts/atlas-accounts-smoke.js",
    "desktop": "node scripts/start-electron.js",
    "desktop:atlas": "node scripts/start-electron.js --atlas",
    "dev:atlas": "node scripts/dev-atlas.js",
    "desktop:update-preview": "node scripts/start-electron.js --preview-update",
    "rebuild:node": "npm rebuild better-sqlite3 argon2",
    "rebuild:electron": "electron-rebuild -f --only better-sqlite3",
    "build:frontend": "npm --prefix ../frontend run build",
    "test:animethemes": "node scripts/animethemes-mapper-smoke.js",
    "test:details-cache": "node scripts/details-cache-smoke.js",
    "test:cache-maintenance": "node scripts/cache-maintenance-smoke.js",
    "test:mal-pipeline": "node scripts/mal-pipeline-smoke.js",
    "test:updater": "node scripts/updater-config-smoke.js",
    "test:layout-config": "node scripts/layout-config-smoke.js",
    "security:check": "node scripts/run-security-smoke.js",
    "analytics:export": "node scripts/export-engagement-analytics.js",
    "test:analytics": "node scripts/engagement-analytics-smoke.js",
    "release:version": "node scripts/set-release-version.js",
    "release:check": "node scripts/release-readiness.js",
    "release:artifacts": "node scripts/release-artifact-smoke.js",
    "pack": "npm run build:frontend && electron-builder --dir",
    "pack:linux": "npm run build:frontend && electron-builder --linux dir --x64",
    "dist": "node scripts/build-release.js",
    "dist:linux": "node scripts/build-linux-release.js",
    "generate:icons": "node scripts/generate-icons.js"
  },
  "keywords": [],
  "author": "Dainius Genzuras",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "argon2": "^0.41.1",
    "better-sqlite3": "^12.8.0",
    "electron-updater": "^6.8.9",
    "mongodb": "^6.21.0",
    "node-fetch": "^2.7.0",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.seenary.desktop",
    "productName": "Seenary",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "../release"
    },
    "files": [
      "desktop-main.js",
      "desktop-preload.js",
      "bundledFrontend.js",
      "desktopEnvironment.js",
      "appLifecycle.js",
      "layoutConfig.js",
      "windowState.js",
      "systemLocale.js",
      "updater.js",
      "startup.js",
      "scripts/write-release-notes.js",
      "tray.js",
      "shortcuts.js",
      "icon.png",
      "icon.ico",
      "tray.png"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "DandelionEater",
        "repo": "Seenary",
        "private": false,
        "tagNamePrefix": "v"
      }
    ],
    "extraMetadata": {
      "main": "desktop-main.js",
      "dependencies": {
        "electron-updater": "^6.8.9"
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "executableName": "Seenary",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "executableName": "seenary",
      "syncDesktopName": true,
      "category": "AudioVideo",
      "synopsis": "Anime and media tracking desktop app",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "Name": "Seenary",
          "Comment": "Track anime, manga, and other media",
          "Categories": "AudioVideo;Utility;"
        }
      }
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "useWaylandFlags": true,
      "finishArgs": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--filesystem=home",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications",
        "--env=XCURSOR_PATH=/run/host/user-share/icons:/run/host/share/icons"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "uninstallerIcon": "build/icon.ico",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "shortcutName": "Seenary"
    }
  }
}
